view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;invalidThumbnail&quot;:&quot;Custom featured images only available with embedded videos. Go back into embed settings to turn off featured images.&quot;,&quot;invalidVideo&quot;:&quot;Invalid video embed.&quot;,&quot;playButton&quot;:&quot;Play&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\"\n  \n  \n>\n  \n  \n    \n    \n      \n        \n        \n        \n        \n          <!-- 1. Search form -->\n<form id=\"staff-date-search\" style=\"display:flex; gap:8px; align-items:end; margin-bottom:5px; flex-wrap:wrap;\">\n  <label>From:\n    <input type=\"date\" id=\"range-from\" required>\n  </label>\n  <label>To:\n    <input type=\"date\" id=\"range-to\" required>\n  </label>\n  <button type=\"submit\">Search</button>\n  <button type=\"button\" id=\"clear-filter\">Clear filter</button>\n</form>\n\n<script>\n  document.getElementById('staff-date-search').addEventListener('submit', function(e) {\n    e.preventDefault();\n    const from = document.getElementById('range-from').value;\n    const to = document.getElementById('range-to').value;\n    const url = new URL(window.location.href);\n    url.searchParams.set('from', from);\n    url.searchParams.set('to', to);\n    window.location.href = url.toString();\n  });\n\n  document.getElementById('clear-filter').addEventListener('click', function() {\n    const url = new URL(window.location.href);\n    url.searchParams.delete('from');\n    url.searchParams.delete('to');\n    window.location.href = url.toString();\n  });\n\n  (function() {\n    const params = new URLSearchParams(window.location.search);\n    const from = params.get('from');\n    const to = params.get('to');\n    if (from) document.getElementById('range-from').value = from;\n    if (to) document.getElementById('range-to').value = to;\n  })();\n\n  // Build the filter attribute BEFORE writing the real widget div to the page\n  var elfsightDateAttr = '';\n  (function() {\n    const params = new URLSearchParams(window.location.search);\n    const from = params.get('from');\n    const to = params.get('to');\n    if (from && to) {\n      elfsightDateAttr = ' data-elfsight-app-filter-dates=\"' + from + ', ' + to + '\"';\n    }\n  })();\n  document.write('<div class=\"elfsight-app-3a701ffd-3d13-4b01-b7a4-d56f353d5907\" data-elfsight-app-lazy' + elfsightDateAttr + '></div>');\n</script>\n\n<!-- Elfsight's loader \u2014 the ONLY copy of this on the whole page -->\n<script src=\"https://elfsightcdn.com/platform.js\" async></script>\n        \n        \n        \n      \n    \n  \n  \n    \n\n\n\n  \n</div>\n\n\n  <style class=\"transform-vars\">\n    #block-yui_3_17_2_1_1786682537492_2195 {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n</div></div></div></div></div>","website":{"id":"56a269b7d8af10a5072cc0c2","captchaSettings":{"enabledForDonations":false},"cloneable":false,"contentModifiedOn":1790102974006,"identifier":"maysles","imageMetadataProcessingEnabled":false,"isHstsEnabled":false,"language":"en-US","location":{"mapLat":40.8094268,"mapLng":-73.94475779999999,"addressTitle":"maysles documentary center","addressLine1":"343 Malcolm X Boulevard","addressLine2":"New York, NY, 10027","addressCountry":"United States"},"logoImageId":"599c99e99f74569171622e20","primaryDomain":"www.maysles.org","screenshotId":"e6c054ba12d0e7caf13fdcf5034bb0778a3
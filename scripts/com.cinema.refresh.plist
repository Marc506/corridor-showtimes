<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cinema.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/yanghaolei/cinema/scripts/refresh.sh</string>
  </array>
  <!-- 01:00 and 13:00 local time (this Mac is on New York time). If the Mac is asleep,
       launchd runs the missed job once on wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/yanghaolei/cinema/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yanghaolei/cinema/logs/launchd.err.log</string>
  <!-- Run in the logged-in GUI session so MoMA's (headed) browser can open a window. -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
